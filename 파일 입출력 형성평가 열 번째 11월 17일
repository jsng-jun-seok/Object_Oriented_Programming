import java.io.*;
import java.nio.charset.StandardCharsets;
import java.nio.file.*;
import java.util.*;
import java.util.regex.*;

public class Main {
    public static void main(String[] args) throws Exception {
        String input = findAndReadInput();

        Matcher m = Pattern.compile("-?\\d+").matcher(input);
        int n = m.find() ? Integer.parseInt(m.group()) : 0;

        long fact = 1;
        for (int i = 2; i <= n; i++) {
            fact *= i;
        }

        try (PrintWriter pw = new PrintWriter(new FileWriter("output.txt"))) {
            pw.println(fact);
        }
        System.out.println(fact);
    }

    private static String findAndReadInput() {
        List<Path> searchRoots = new ArrayList<>();
        Path cur = Paths.get(".").toAbsolutePath().normalize();
        searchRoots.add(cur);
        if (cur.getParent() != null) searchRoots.add(cur.getParent());
        if (cur.getParent() != null && cur.getParent().getParent() != null) {
            searchRoots.add(cur.getParent().getParent());
        }
        searchRoots.add(Paths.get("/work"));
        searchRoots.add(Paths.get("/tmp"));

        for (Path root : searchRoots) {
            if (!Files.exists(root)) continue;
            try {
                Optional<Path> found = Files.walk(root, 4)
                        .filter(Files::isRegularFile)
                        .filter(p -> {
                            String name = p.getFileName().toString().toLowerCase();
                            return name.equals("input.txt") || name.endsWith(".in");
                        })
                        .filter(p -> {
                            try {
                                return Files.size(p) > 0;
                            } catch (IOException e) {
                                return false;
                            }
                        })
                        .findFirst();

                if (found.isPresent()) {
                    return new String(Files.readAllBytes(found.get()), StandardCharsets.UTF_8).trim();
                }
            } catch (Exception ignored) {}
        }

        try {
            if (System.in.available() > 0) {
                return new String(System.in.readAllBytes(), StandardCharsets.UTF_8).trim();
            }
        } catch (Exception ignored) {}

        return "";
    }
}

