#include <iostream>
using namespace std;

int diffOfSquares(int a, int b) {
    if (a > b) {
        return a * a - b * b;
    } else {
        return b * b - a * a;
    }
}

int main() {
    int a, b;
    cin >> a >> b;
    cout << diffOfSquares(a, b) << "\n";
    return 0;
}

