#include <iostream>
using namespace std;

int score[4][4]; // 0~2행: 학생 점수, 3행: 과목별 총점 / 0~2열: 과목 점수, 3열: 학생별 총점

void inputScores() {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            cin >> score[i][j];
        }
    }
}

void calculateTotals() {
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++) {
            score[i][3] += score[i][j]; // 학생별 총점 누적
            score[3][j] += score[i][j]; // 과목별 총점 누적
            score[3][3] += score[i][j]; // 전체 총점 누적
        }
    }
}

void printResults() {
    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4; j++) {
            cout << score[i][j] << " ";
        }
        cout << "\n";
    }
}

int main() {
    inputScores();
    calculateTotals();
    printResults();
    return 0;
}

