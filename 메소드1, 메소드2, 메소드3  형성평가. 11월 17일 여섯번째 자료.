#include <iostream>
using namespace std;

void printSum(int n) {
    int sum = 0;
    for (int i = 1; i <= n; i++) {
        sum += i;
    }
    cout << sum << "\n";
}

int main() {
    int n;
    cin >> n;
    printSum(n);
    return 0;
}

