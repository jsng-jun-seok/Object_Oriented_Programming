import java.util.Scanner;

public class Main {
    // T시간 후의 세균 수(3의 T제곱)를 반환하는 함수
    public static int countBacteria(int t) {
        int result = 1;
        for (int i = 0; i < t; i++) {
            result *= 3;
        }
        return result;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int t = sc.nextInt();

        System.out.println(countBacteria(t));
    }
}

