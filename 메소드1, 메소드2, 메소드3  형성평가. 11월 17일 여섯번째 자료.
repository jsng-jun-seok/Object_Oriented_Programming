import java.util.Scanner;

public class Main {
    public static int multiplyNonZeroDigits(long n) {
        if (n == 0) return 1;

        int digit = (int)(n % 10);
        if (digit == 0) {
            return multiplyNonZeroDigits(n / 10);
        } else {
            return digit * multiplyNonZeroDigits(n / 10);
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        long a = sc.nextLong();
        long b = sc.nextLong();
        long c = sc.nextLong();

        long product = a * b * c;
        System.out.println(multiplyNonZeroDigits(product));
    }
}
