import java.util.Scanner;

public class Main {
    public static int countDivisions(int n) {
        if (n == 1) return 0;

        if (n % 2 == 0) {
            return 1 + countDivisions(n / 2);
        } else {
            return 1 + countDivisions(n / 3);
        }
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        System.out.println(countDivisions(n));
    }
}

