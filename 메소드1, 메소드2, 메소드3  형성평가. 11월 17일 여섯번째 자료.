import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int x = sc.nextInt();

        int ans = 0;
        int minDiff = 1000;

        for (int i = 0; i < n; i++) {
            int a = sc.nextInt();
            int diff = Math.abs(x - a);

            if (diff < minDiff) {
                minDiff = diff;
                ans = a;
            }
        }

        System.out.println(ans);
    }
}

