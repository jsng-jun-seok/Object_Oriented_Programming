import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String a = sc.next();
        String b = sc.next();
        int n = sc.nextInt();

        // 1. A에 B를 연결
        a = a + b;

        // 2. 변경된 문자열 A에서 앞 n개의 문자를 B에 복사
        String prefix = a.substring(0, n);
        if (n >= b.length()) {
            b = prefix;
        } else {
            b = prefix + b.substring(n);
        }

        // 3. A와 B 출력
        System.out.println(a);
        System.out.println(b);
    }
}

// 형성평가 (7)

import java.util.Scanner;

public class Main {
    // C의 atoi처럼 앞에서부터 부호 및 숫자 부분만 추출해 정수로 변환하는 함수
    public static long parsePrefixInt(String s) {
        int i = 0, len = s.length();
        long sign = 1, num = 0;

        if (i < len && (s.charAt(i) == '+' || s.charAt(i) == '-')) {
            if (s.charAt(i) == '-') sign = -1;
            i++;
        }

        while (i < len && Character.isDigit(s.charAt(i))) {
            num = num * 10 + (s.charAt(i) - '0');
            i++;
        }

        return sign * num;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s1 = sc.next();
        String s2 = sc.next();

        long n1 = parsePrefixInt(s1);
        long n2 = parsePrefixInt(s2);

        System.out.println(n1 * n2);
    }
}

