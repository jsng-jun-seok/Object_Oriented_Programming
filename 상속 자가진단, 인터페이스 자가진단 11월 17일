import java.util.Scanner;

class Super {
    String name;
    int age;

    Super(String name, int age) {
        this.name = name;
        this.age = age;
    }

    void output() {
        System.out.println("name : " + name);
        System.out.println("Super age : " + age);
    }
}

class Sub extends Super {
    int age;
    String address;

    Sub(String name, int superAge, int subAge, String address) {
        super(name, superAge);
        this.age = subAge;
        this.address = address;
    }

    @Override
    void output() {
        super.output();
        System.out.println("Sub age : " + this.age);
        System.out.println("address : " + this.address);
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String name = sc.next();
        int superAge = sc.nextInt();
        int subAge = sc.nextInt();
        String address = sc.next();

        Super obj = new Sub(name, superAge, subAge, address); // 업캐스팅
        obj.output();
    }
}
