import java.util.Scanner;

class Figure {
    double getArea() {
        return 0.0;
    }

    void output() {
    }
}

class Circle extends Figure {
    double radius;

    Circle(double radius) {
        this.radius = radius;
    }

    @Override
    double getArea() {
        return radius * radius * 3.14;
    }

    @Override
    void output() {
        System.out.printf("Circle's area : %.1f\n", getArea());
    }
}

class Triangle extends Figure {
    double base, height;

    Triangle(double base, double height) {
        this.base = base;
        this.height = height;
    }

    @Override
    double getArea() {
        return base * height / 2.0;
    }

    @Override
    void output() {
        System.out.printf("Triangle's area : %.1f\n", getArea());
    }
}

class Rectangle extends Figure {
    double width, length;

    Rectangle(double width, double length) {
        this.width = width;
        this.length = length;
    }

    @Override
    double getArea() {
        return width * length;
    }

    @Override
    void output() {
        System.out.printf("Rectangle area : %.1f\n", getArea());
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        double r = sc.nextDouble();
        double b = sc.nextDouble();
        double h = sc.nextDouble();
        double w = sc.nextDouble();
        double l = sc.nextDouble();

        Figure[] figures = {
            new Circle(r),
            new Triangle(b, h),
            new Rectangle(w, l)
        };

        for (Figure f : figures) {
            f.output();
        }
    }
}

