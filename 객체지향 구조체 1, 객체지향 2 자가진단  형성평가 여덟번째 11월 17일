import java.util.Scanner;

class Student {
    String name;
    int score;
    static int passCount = 0; // 클래스 변수(static 변수)

    Student(String name, int score) {
        this.name = name;
        this.score = score;
        if (score >= 80) {
            passCount++;
        }
    }

    boolean isPassed() {
        return score >= 80;
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Student[] students = new Student[5];

        for (int i = 0; i < 5; i++) {
            String name = sc.next();
            int score = sc.nextInt();
            students[i] = new Student(name, score);
        }

        System.out.println("Passed number : " + Student.passCount);
        for (int i = 0; i < 5; i++) {
            if (students[i].isPassed()) {
                System.out.println(students[i].name);
            }
        }
    }
}

