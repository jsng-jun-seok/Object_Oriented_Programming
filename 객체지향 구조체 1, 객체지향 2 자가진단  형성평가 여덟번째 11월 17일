import java.util.Scanner;

class Time {
    int hour, min, sec;

    Time() {
        set(0, 0, 0);
    }

    Time(int h) {
        set(h, 0, 0);
    }

    Time(int h, int m, int s) {
        set(h, m, s);
    }

    void set(int h, int m, int s) {
        this.hour = h;
        this.min = m;
        this.sec = s;
    }

    void output(String label) {
        System.out.println(label + " -> hour : " + hour + ", minute : " + min + ", second : " + sec);
    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int h1 = sc.nextInt();
        int h2 = sc.nextInt();
        int m2 = sc.nextInt();
        int s2 = sc.nextInt();

        Time t1 = new Time();
        Time t2 = new Time(h1);
        Time t3 = new Time(h2, m2, s2);

        t1.output("Midnight");
        t2.output("Input time");
        t3.output("Promise");
    }
}

