import java.util.Scanner;

public class Main {
    static class Body {
        int height;
        double weight;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Body father = new Body();
        Body mother = new Body();
        Body student = new Body();

        father.height = sc.nextInt();
        father.weight = sc.nextDouble();
        mother.height = sc.nextInt();
        mother.weight = sc.nextDouble();

        student.height = (father.height + mother.height) / 2 + 5;
        student.weight = (father.weight + mother.weight) / 2.0 - 4.5;

        System.out.println("height : " + student.height + "cm");
        System.out.printf("weight : %.1fkg\n", student.weight);
    }
}

// 형성평가 (5)

import java.util.Arrays;
import java.util.Scanner;

public class Main {
    static class Student {
        String name;
        int s1, s2, s3;
        int total;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        Student[] students = new Student[n];
        for (int i = 0; i < n; i++) {
            students[i] = new Student();
            students[i].name = sc.next();
            students[i].s1 = sc.nextInt();
            students[i].s2 = sc.nextInt();
            students[i].s3 = sc.nextInt();
            students[i].total = students[i].s1 + students[i].s2 + students[i].s3;
        }

        Arrays.sort(students, (a, b) -> Integer.compare(b.total, a.total));

        for (int i = 0; i < n; i++) {
            System.out.println(students[i].name + " " +
                               students[i].s1 + " " +
                               students[i].s2 + " " +
                               students[i].s3 + " " +
                               students[i].total);
        }
    }
}

