import java.util.Scanner;

public class Main {
    static class Person {
        String name;
        String tel;
        String addr;
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        Person[] p = new Person[3];

        for (int i = 0; i < 3; i++) {
            p[i] = new Person();
            p[i].name = sc.next();
            p[i].tel = sc.next();
            p[i].addr = sc.next();
        }

        int firstIdx = 0;
        for (int i = 1; i < 3; i++) {
            if (p[i].name.compareTo(p[firstIdx].name) < 0) {
                firstIdx = i;
            }
        }

        System.out.println("name : " + p[firstIdx].name);
        System.out.println("tel : " + p[firstIdx].tel);
        System.out.println("addr : " + p[firstIdx].addr);
    }
}

